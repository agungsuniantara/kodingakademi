                <zone fixed-size='280' h='10667' id='74' is-fixed='true' name='Kpmm' w='28257' x='69289' y='32467'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='4800' id='77' type-v2='text' w='28511' x='69289' y='43733'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Pertumbuhan 2022 - 2023 : 1,85%</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Æ    </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Kewajiban Penyediaan Modal Minimum (KPMM) menunjukkan kemampuan bank untuk memenuhi kewajiban modal minimum yang ditentukan oleh regulator (OJK/BI). Nilai KPMM BRI sebesar 24% lebih besar dari batas minimum KPMM yaitu 14% - 17% ini mengindikasikan struktur modal BRI sangat baik serta menunjukkan stabilitas keuangan.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='4800' id='73' type-v2='text' w='28511' x='36464' y='43933'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Pertumbuhan 2022 - 2023 : 1,85%</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Æ    </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Cost to Income Ratio (CIR) menunjukkan efisiensi operasional bank, semakin rendah CIR semakin efisien bank dalam mengelola biayanya terhadap pendapatan. Kenaikan CIR dari 2022 ke 2023 menunjukkan bahwa efisiensi operasional Bank BRI sedikit menurun, karena biaya operasional relatif meningkat dibandingkan dengan pendapatan yang dihasilkan.</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Æ </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='3633' id='69' type-v2='text' w='28596' x='3130' y='44033'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Pertumbuhan 2022 - 2023 : 0,23%</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Æ    </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Beban Operasional terhadap Pendapatan Operasional</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> (</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>BOPO) menunjukkan efisiensi operasional bank, dengan rasio yang tetap stabil di sekitar 64%. BRI mempertahankan efisiensi yang baik dalam operasionalnya.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='41' h='1367' id='108' is-fixed='true' is-scaled='1' param='/Users/suniantara/Downloads/centang.jpg' type-v2='bitmap' w='3976' x='85110' y='50700'>
