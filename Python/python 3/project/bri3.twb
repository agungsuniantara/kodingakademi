                <zone h='2133' id='67' name='Bopo' pane-specification-id='0' param='[federated.0x16ab105s4ukk1b2h7jo1yb9uwj].[:Measure Names]' type-v2='color' w='12183' x='65144' y='28300'>
                  <zone-style>
