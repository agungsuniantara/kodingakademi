                <zone forceUpdate='true' h='3567' id='50' type-v2='text' w='28426' x='2961' y='22667'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Pertumbuhan 2022 - 2023 : Rp59.569 miliar (5.8%)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Æ    </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Pertumbuhan kredit sebesar 5.8% mengindikasikan ekspansi bisnis dan peningkatan permintaan dari nasabah. Hal ini mencerminkan kepercayaan pasar terhadap BRI.</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Æ </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2433' id='55' type-v2='text' w='28765' x='36464' y='22700'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Penurunan 2022 - 2023 : Rp86.332 miliar (32,46%)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Æ    </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Penurunan likuiditas dapat menjadi tanda alokasi dana ke aset lain atau aktivitas investasi yang kurang efisien.</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Æ </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2700' id='60' type-v2='text' w='28765' x='69120' y='22767'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Penurunan 2022 - 2023 : Rp66.232 miliar (3,8%)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Æ    </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Meski ada penurunan, modal BRI tetap dalam kondisi sangat aman dan mencukupi untuk mendukung operasional.</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Æ </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
