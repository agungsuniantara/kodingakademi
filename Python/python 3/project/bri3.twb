                <zone fixed-size='41' h='1367' id='138' is-fixed='true' is-scaled='1' param='/var/folders/q2/2h4p204s56d3vhv_jx5hmc6m0000gn/T/tableau-temp/0vezl8z0trxal41ejod6d13a73fm/Sheets1/Image/centang.jpg' type-v2='bitmap' w='3976' x='18274' y='50833'>
