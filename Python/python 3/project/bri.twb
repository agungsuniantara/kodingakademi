                  </zone-style>
                </zone>
                <zone fixed-size='280' h='40822' id='56' is-fixed='true' name='Modal' w='25814' x='71088' y='30837'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='14978' id='55' type-v2='text' w='26052' x='36219' y='71953'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Penurunan 2022 - 2023 : - Rp86.332 miliar (32,46%)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Æ    </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Penurunan total likuiditas dari Rp265.965 miliar pada Desember 2022 menjadi Rp179.633 miliar pada Juni 2023, penurunan ini dapat mencerminkan alokasi dana ke aset lain atau aktivitas operasional dan investasi.</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Æ </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='14978' id='57' type-v2='text' w='27244' x='70929' y='72100'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Penurunan 2022 - 2023 : - Rp 65,357,709 miliar (3,63%)</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Æ    </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Penurunan modal mencerminkan alokasi dana untuk pembagian dividen, investasi strategis, atau penyesuaian kebijakan keuangan. Penurunan ini dapat menjadi bagian dari strategi perusahaan untuk mendukung efisiensi operasional atau ekspansi bisnis.</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Æ </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='16153' id='50' type-v2='text' w='25655' x='2145' y='72540'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Pertumbuhan 2022 - 2023 : Rp59.569 miliar (5.8%)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Æ    </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Pertumbuhan kredit sebesar 5.8% menunjukkan ekspansi bisnis perusahaan. Kredit yang lebih besar mencerminkan meningkatnya permintaan dari nasabah dan kepercayaan perusahaan dalam mengambil risiko kredit.</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Æ </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{95F995F9-4B57-4FDB-9511-87D648FA8365}' />
    </dashboard>
